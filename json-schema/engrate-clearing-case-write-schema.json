  "$defs": {
    "BundleMember": {
      "description": "Ein Knoten des Lokationsbündels. Der Typ wird über das Feld `type` markiert\n(tagged union). Damit ist für jeden Typ genau festgelegt, welche Felder zulässig\nund welche erforderlich sind — Kombinationen, die es fachlich nicht gibt, sind\nnicht darstellbar.\n\nDies ist der in Abschnitt 3.5 der Stellungnahme beschriebene Hebel: Bedingungen,\ndie heute als natürlichsprachliche Ad-hoc-Bedingungen im Anwendungshandbuch stehen\nund von jedem Marktpartner eigenständig implementiert werden, wandern in das\nSchema und werden von Standardwerkzeugen geprüft.\n",
      "oneOf": [
        {
          "$ref": "#/$defs/NetworkLocationMember"
        },
        {
          "$ref": "#/$defs/MeteringLocationMember"
        },
        {
          "$ref": "#/$defs/MarketLocationMember"
        },
        {
          "$ref": "#/$defs/TrancheMember"
        },
        {
          "$ref": "#/$defs/TechnicalResourceMember"
        },
        {
          "$ref": "#/$defs/ControllableResourceMember"
        }
      ]
    },
    "BundleRelation": {
      "description": "Eine gerichtete Kante zwischen zwei Knoten der Zeitscheibe. Quelle und Ziel werden\nüber ihre fachliche ID benannt.\n\nDie zulässigen Typkombinationen sind hier abschließend als `oneOf` festgelegt.\nSie entsprechen den Zuordnungen der konsultierten Fassung:\nNetzlokation → Messlokation, Messlokation → Messlokation,\nMesslokation → Marktlokation, Messlokation → technische Ressource,\nMarktlokation → technische Ressource, Marktlokation → Tranche.\n",
      "oneOf": [
        {
          "$ref": "#/$defs/RelationNeloToMelo"
        },
        {
          "$ref": "#/$defs/RelationMeloToMelo"
        },
        {
          "$ref": "#/$defs/RelationMeloToMalo"
        },
        {
          "$ref": "#/$defs/RelationMeloToTr"
        },
        {
          "$ref": "#/$defs/RelationMaloToTr"
        },
        {
          "$ref": "#/$defs/RelationMaloToTranche"
        }
      ]
    },
    "ControllableResourceMember": {
      "type": "object",
      "required": [
        "type",
        "srId"
      ],
      "additionalProperties": false,
      "properties": {
